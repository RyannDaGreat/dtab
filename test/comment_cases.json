    "\t line one",
    "",
    "\t\t deeper",
    " next 1"
   ]
  },
  {
   "name": "a table in a string: only the run starts move",
   "lines": [
    "t txt",
    "\tname\tage",
    "\tryan\t30"
   ],
   "selections": [
    [
     1,
