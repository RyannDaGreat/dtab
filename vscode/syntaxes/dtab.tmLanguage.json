{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "dtab",
    "scopeName": "source.dtab",
    "comment": "Same tokens as dtab.vim: an entry between tabs is a comment (leading space), a leaf (key value) or an object key. Keys must be identifiers. `$key [tag]` opens a multiline block: every following line indented deeper than the $ line (bound with a backreference to its tabs) is value text, highlighted as the tag's language, or as the language named by a shebang on the block's first line.",
    "patterns": [
        {
            "comment": "A whitespace-only line",
            "match": "^\\s*$"
        },
        {
            "comment": "$key sql: the block is highlighted as sql",
            "begin": "^(\\t*)((?:[^\\t\\n]*\\t+)*)(\\$[\\p{L}_][\\p{L}\\p{N}_]*(?:,[\\p{L}_][\\p{L}\\p{N}_]*)*) (sql)(?=\\t|$)(\\t[^\\n]*)?",
            "beginCaptures": {
                "2": {
                    "name": "meta.entries-before-block.dtab",
                    "patterns": [
                        {
                            "include": "#entry"
                        }
                    ]
                },
                "3": {
                    "name": "entity.name.function.block-key.dtab",
                    "patterns": [
                        {
                            "include": "#comma"
                        }
                    ]
                },
                "4": {
                    "name": "markup.italic entity.other.attribute-name.block-tag.dtab"
                },
                "5": {
                    "name": "markup.italic string.unquoted.block.dtab"
                }
            },
            "while": "^(?:\\1\\t|\\s*$)",
            "contentName": "meta.embedded.block.sql",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "$key python: the block is highlighted as python",
            "begin": "^(\\t*)((?:[^\\t\\n]*\\t+)*)(\\$[\\p{L}_][\\p{L}\\p{N}_]*(?:,[\\p{L}_][\\p{L}\\p{N}_]*)*) (python|py)(?=\\t|$)(\\t[^\\n]*)?",
            "beginCaptures": {
                "2": {
                    "name": "meta.entries-before-block.dtab",
                    "patterns": [
                        {
                            "include": "#entry"
                        }
                    ]
