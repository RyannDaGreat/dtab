{
    "name": "deltatab",
    "version": "0.5.8",
    "description": "Delta Tab: config files made of tab-separated paths. One line is one path into a tree.",
    "main": "dtab.js",
    "bin": {
        "dtab": "dtab.js"
    },
    "files": [
        "dtab.js",
        "tools.js",
