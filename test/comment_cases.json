    ]
   ],
   "expected": [
    "café\t 😀 1"
   ]
  },
  {
   "name": "multibyte characters: selecting the é",
   "lines": [
    "café\t😀 1"
   ],
   "selections": [
    [
     0,
     3,
     0,
     4
    ]
   ],
   "expected": [
    " café\t😀 1"
   ]
  },
  {
   "name": "multibyte characters in comments, by caret",
   "lines": [
    " 😀\t é"
   ],
   "selections": [
    [
     0,
     1,
     0,
     1
    ]
   ],
   "expected": [
    "😀\té"
   ]
  },
  {
   "name": "a selection ending right after an emoji",
